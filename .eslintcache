 state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\JasonPaff\\dev\\clarify-ai\\hooks\\use-leave-warning.ts:107:7\n  105 |     if (!isActive) {\n  106 |       // eslint-disable-next-line react-hooks/set-state-in-effect -- Synchronizing state with prop transition is valid\n> 107 |       setIsWarningRequested(false);\n      |       ^^^^^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  108 |     }\n  109 |   }, [isActive]);\n  110 |",["1621"],"perfectionist/sort-interfaces","Expected \"/\" to come before \"/help\".","TSPropertySignature","unexpectedInterfacePropertiesOrder",{"range":"1622","text":"1623"},["1624"],{"kind":"1625","justification":"1626"},{"messageId":"1627","data":"1628","fix":"1629","desc":"1630"},{"kind":"1625","justification":"1626"},{"kind":"1625","justification":"1626"},{"kind":"1625","justification":"1626"},{"kind":"1625","justification":"1626"},{"kind":"1625","justification":"1626"},{"kind":"1625","justification":"1626"},{"kind":"1625","justification":"1626"},{"kind":"1625","justification":"1631"},{"kind":"1625","justification":"1626"},{"kind":"1625","justification":"1626"},{"kind":"1625","justification":"1632"},{"kind":"1625","justification":"1633"},[976,1020],"\"/\": StaticRoute;\r\n    \"/help\": StaticRoute;",{"kind":"1625","justification":"1626"},"directive","","suggestComment",{"name":"1634"},{"range":"1635","text":"1636"},"Add comment inside empty arrow function.","data attribute selectors are valid","animate-shimmer is defined in globals.css","Synchronizing state with prop transition is valid","arrow function",[7046,7046]," /* empty */ "]